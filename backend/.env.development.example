# ==========================================
# GNV MANAGER BACKEND - DESARROLLO (DEV)
# TEMPLATE DE CONFIGURACIÓN
# ==========================================
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# Secretos JWT (Autenticación local)
JWT_SECRET=tu_clave_secreta_jwt_para_desarrollo
JWT_EXPIRATION=8h

# PostgreSQL Local (vía docker-compose.dev.yml en puerto 5433)
# O apuntar a Supabase Dev / Staging si aplica
DATABASE_URL="postgresql://gnv_dev:gnv_dev_password@localhost:5433/gnv_manager_dev?schema=public"
DIRECT_URL="postgresql://gnv_dev:gnv_dev_password@localhost:5433/gnv_manager_dev?schema=public"
