# ==========================================
# GNV MANAGER BACKEND - VARIABLES DE ENTORNO
# ==========================================
# Este archivo es un template. Copiar como `.env` localmente.

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Configuración CORS (Dominios permitidos separados por coma)
CORS_ORIGINS=http://localhost:5173

# Secretos JWT (Autenticación)
# Generar un hash fuerte de 256 bits para producción
JWT_SECRET=super_secret_gnv_dev_key_2026
JWT_EXPIRATION=8h

# Conexión a Base de Datos
# Ejemplo SQLite
DB_CLIENT=sqlite
DB_CONNECTION_STRING=./data/gnv_manager.sqlite

# Ejemplo PostgreSQL (Para futuro uso en Producción)
# DB_CLIENT=postgresql
# DB_CONNECTION_STRING=postgres://usuario:contraseña@localhost:5432/gnv_db
