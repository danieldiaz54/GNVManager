# ==========================================
# GNV MANAGER BACKEND - PRODUCCIÓN (PROD)
# TEMPLATE DE CONFIGURACIÓN
# ==========================================
PORT=3000
NODE_ENV=production
CORS_ORIGINS=https://tu-dominio.com,https://tu-app.vercel.app

# Secretos JWT (Autenticación)
# Reemplazar con una clave criptográfica de 256 bits segura
JWT_SECRET=reemplazar_con_clave_secreta_fuerte_en_produccion
JWT_EXPIRATION=8h

# Supabase PostgreSQL (Producción)
# DATABASE_URL: Puerto 6543 con connection pooling (pgbouncer)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Puerto 5432 conexión directa (Requerido por Prisma para migraciones)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
