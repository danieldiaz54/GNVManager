// Este es tu archivo de esquema Prisma,
// aprende más sobre él en la documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Modelo de Base de Datos (Libro Mayor de Conciliación)
model ReconciliationRecord {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Tipo de registro: "INDIVIDUAL" | "RACK_PARENT" | "RACK_CHILD" | "MANIFOLD_PARENT" | "MANIFOLD_CHILD"
  recordType String @default("INDIVIDUAL")

  // Identificador opcional (ej. "RACK-01" o "PLACA-GNV") y posición (1 a 11)
  moduleIdentifier String?
  positionNumber   Int?

  // Operación: "CARGUE" o "DESCARGUE"
  operationType String @default("DESCARGUE")

  // Relación Jerárquica para Rack
  parentId String?
  parent   ReconciliationRecord?  @relation("ManifoldHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ReconciliationRecord[] @relation("ManifoldHierarchy")

  // Capacidad del módulo o cilindro individual
  moduleCapacityLiters Float

  // Estado inicial
  initialPressureBar Float
  initialTempK       Float

  // Estado final tras la descarga
  finalPressureBar Float
  finalTempK       Float

  // Resultados del Motor Termodinámico
  calculatedMassKg    Float
  calculatedVolumeSm3 Float

  // Eventos inmutables (Append-Only Ledger)
  events ReconciliationEvent[]

  @@map("reconciliation_records")
}

// Modelo de Eventos para Ledger Inmutable
model ReconciliationEvent {
  id            String   @id @default(uuid())
  recordId      String
  eventType     String // e.g., "SALE_DISPENSED"
  saleVolumeSm3 Float?
  createdAt     DateTime @default(now())

  record ReconciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@map("reconciliation_events")
}

// Modelo de Usuarios (Autenticación)
model User {
  id           String   @id @default(uuid())
  username     String   @unique
  fullName     String?  @map("full_name")
  passwordHash String   @map("password_hash")
  role         String   @default("user")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

// Perfil de Gas Completo (Cromatografía)
model GasProfile {
  id   String @id @default(uuid())
  name String @unique

  // Trazabilidad
  reportDate   DateTime?
  reportNumber String?

  // Componentes Principales (% mol)
  methanePercentage       Float // C1
  ethanePercentage        Float? // C2
  propanePercentage       Float? // C3
  isoButanePercentage     Float? // i-C4
  normalButanePercentage  Float? // n-C4
  isoPentanePercentage    Float? // i-C5
  normalPentanePercentage Float? // n-C5
  hexanesPlusPercentage   Float? // C6+

  // Inertes (% mol)
  nitrogenPercentage      Float? // N2
  carbonDioxidePercentage Float? // CO2
  oxygenPercentage        Float? // O2

  // Propiedades Físicas / Termodinámicas
  grossCalorificValue   Float? // Poder Calorífico Superior (BTU/ft3 o MJ/m3)
  specificGravity       Float // Gravedad Específica
  molarMass             Float // Masa Molar (g/mol)
  compressibilityFactor Float? // Factor de Compresibilidad (Z a condiciones estándar)
  wobbeIndex            Float? // Índice de Wobbe

  // Constantes Críticas
  criticalPressure    Float
  criticalTemperature Float

  createdAt DateTime @default(now())

  @@map("gas_profiles")
}

// Módulo de Almacenamientos
model StorageModule {
  id                     String   @id @default(uuid())
  name                   String   @unique
  type                   String // "ESTACIONARIA" o "TRANSPORTE"
  cylinderCount          Int
  cylinderCapacityLiters Float
  totalCapacityLiters    Float
  createdAt              DateTime @default(now())

  @@map("storage_modules")
}
