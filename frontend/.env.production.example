# ==============================================================================
# GNV MANAGER FRONTEND - PLANTILLA DE ENTORNO DE PRODUCCIÓN (PROD)
# ==============================================================================
# Copie este archivo como `.env.production` o configure estas variables en su proveedor de hosting (Vercel / Cloud).

# URL base para conectar con el backend en producción.
# En despliegues integrados o con reverse proxy (Vercel rewrites), puede usarse ruta relativa '/api/v1'.
# En despliegues desacoplados, use la URL pública del backend (ej. 'https://api.gnvmanager.com/api/v1').
VITE_API_URL=https://api.gnvmanager.com/api/v1

# Identificador del entorno de la aplicación ('production')
VITE_APP_ENV=production
